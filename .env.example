# Copy this file to .env for local development, or set these as
# environment variables in your Railway/Render project settings.

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

DEBUG=False

# Comma-separated, no spaces, no scheme (https:// is added automatically)
ALLOWED_HOSTS=your-app.up.railway.app

# Railway/Render inject this automatically when you attach a Postgres
# database — you normally don't set it by hand.
# DATABASE_URL=postgres://user:password@host:port/dbname
